{
  "manifest_version": 3,
  "name": "OBSChzzkEvent 리모컨 이벤트 브리지",
  "version": "0.4.1",
  "description": "치지직 리모컨의 팔로우 WebSocket 이벤트를 OBSChzzkEvent로 전달합니다.",
  "action": {
    "default_title": "OBSChzzkEvent 연결 테스트",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://studio.chzzk.naver.com/*"],
      "js": ["websocket-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://studio.chzzk.naver.com/*"],
      "js": ["obs-client.js", "relay.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["http://127.0.0.1:21345/*"]
}
